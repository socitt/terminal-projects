[[target]]
name = "engine"
type = "library"
srcs = ["engine.py"]

[[target]]
name = "engine_test"
type = "test"
srcs = ["engine_test.py"]
deps = [":engine"]

[[target]]
name = "runner"
type = "library"
srcs = ["runner.py"]
deps = [":engine", "//shared:term", "//shared:input"]

[[target]]
name = "runner_test"
type = "test"
srcs = ["runner_test.py"]
deps = [":runner"]

[[target]]
name = "main"
type = "library"
srcs = ["main.py"]
deps = [":runner", "//region-explorer/data:washington"]

[[target]]
name = "main_test"
type = "test"
srcs = ["main_test.py"]
deps = [":main"]
