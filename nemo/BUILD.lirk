# Nemo's top-level package: level constants. `nemo.search` and
# `nemo.cam` are nested packages with their own BUILD.lirk files; both
# import this one, so every Nemo target's closure includes it.
[[target]]
name = "nemo"
type = "library"
srcs = ["__init__.py"]

[[target]]
name = "ui"
type = "library"
srcs = ["ui.py"]
deps = [":nemo", "//nemo/search:minimax", "//nemo/cam:avatar", "//shared:input"]

[[target]]
name = "ui_test"
type = "test"
srcs = ["ui_test.py"]
deps = [":ui"]
