; Please config file
;
; Pinned to the version confirmed working under iSH-AOK. Anyone running
; `plz` (or `./pleasew`, which doesn't even need plz preinstalled) in this
; repo gets exactly this version — same idea as Bazel pinning a version in
; .bazelversion, for reproducibility across machines.
[please]
version = 17.31.2

[parse]
preloadsubincludes = ///python//build_defs:python

[Plugin "python"]
Target = //plugins:python
; Default python_test runner is stdlib-only unittest, wired to
; //tools/plz_test_runner instead of Please's built-in `unittest`
; runner. The built-in one depends on the xmlrunner/portalocker
; wheels, whose fetch/repackage build step hangs under iSH-AOK
; (signal: hangup) — see docs/KNOWN_ISSUES.md.
TestRunner = tools.plz_test_runner.runner.run
TestrunnerDeps = //tools/plz_test_runner:runner
